<!DOCTYPE html>
<html>
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
  <title>Type Approval Certificate (International)</title>
  <style>
    /* Force explicit landscape size to avoid Dompdf defaults */
    @page { size: 297mm 210mm; }
    html { margin:0; padding:0; }
    body { padding: 8mm; }
    body { font-family: Cambria, Georgia, "Times New Roman", Times, serif; color: #111; font-size: 12pt; }

    /* Frame border similar to the sample image */
    .frame { position: relative; min-height: 182mm; padding: 4mm; border: 8px double #9bbb59; padding-top: 3mm; }
    .frame:after { content:''; position:absolute; inset:1mm; border: 2px solid #9bbb59; }
    .content { position: relative; z-index: 2; }

    /* Header */
    .logo-wrap { text-align:center; }
    .logo { display:inline-block; height: 28mm; }
    .title-org { text-align:center; font-weight:700; font-size: 18pt; }
    .title-cert { text-align:center; font-weight:700; font-size: 14pt; margin-top: 2mm; }
    .subtitle { text-align:center; font-size: 10pt; margin-bottom: 2mm; font-weight: bold; }
    .dotline { border-top: 2px dotted #333; margin: 2mm auto 3mm auto; width: 75%; }

    /* Utility */
    .row { margin-bottom: 1mm; }
    .muted { color: #444; }

    /* Certificate info */
    .info { display:flex; justify-content: space-around; margin: 4mm 0; font-weight: bold; }

    /* Product details table */
    table { width:80%; border-collapse: collapse; margin: 6mm auto 0; table-layout: fixed; }
    th, td { border:1px solid #000; vertical-align: top; }
    th { text-align:center; background:#f5f5f5; font-weight:700; }
    .w25 { width: 25%; }

    .pagebreak { page-break-after: always; }

    .sign { position: absolute; right: 30mm; bottom: 22mm; text-align:center; }
    .sign img { height: 42mm; }
  </style>
</head>
<body>
  <!-- Page 1 -->
  <div class="frame">
    <div class="content">
      {% if assets.logo_image %}
        <div class="logo-wrap"><img class="logo" src="{{ assets.logo_image }}" alt="CCK"/></div>
      {% endif %}
      <div class="title-org">Communications Commission of Kiribati</div>
      <div class="title-cert">TYPE APPROVAL CERTIFICATE</div>
      <div class="subtitle">(Rule 15 of Type Approval Rules made under Section 61 and 62 of the Communications Act)</div>
      <div class="dotline"></div>

      <div class="info" style="text-align:center;">
        Certificate Number: <span>C{{ '%03d'|format(webform_submission.id()) }}</span>
        <span style="visibility: hidden">...........................................................................................................................</span>
        Date of Issue: <span>{{ "now"|date('d/m/y') }}</span>
      </div>

      <div class="row" style="margin-bottom:3mm;">
        This Type Approval Certificate certifies that the undernoted product meets the requirements of the Commission's Type Approval Rules and is duly issued to:
      </div>

      <div class="row" style="text-align:center; font-weight:700;">Certificate Holder information:</div>
      <div class="row" style="text-align:center;"><strong>Applicant Name:</strong> <span>{{ applicant.full_name ?: applicant.organization }}</span></div>
      <div class="row" style="text-align:center;"><strong>Physical Address:</strong> <span>{{ applicant.physical_address }}</span></div>

      <table>
        <tr>
          <th colspan="2" style="text-align:center; background:#fff; font-size: 12pt;">Product Details</th>
        </tr>
        <tr>
          <td class="w25"><strong>Product Name</strong></td>
          <td><span>{{ device.product_name ?: device.model ?: devices|first.model }}</span></td>
        </tr>
        <tr>
          <td><strong>Model</strong></td>
          <td><span>{{ device.model ?: devices|first.model }}</span></td>
        </tr>
        <tr>
          <td><strong>Brand</strong></td>
          <td><span>{{ device.brand }}</span></td>
        </tr>
        <tr>
          <td><strong>Category</strong></td>
          <td><span>{{ device.category }}</span></td>
        </tr>
        <tr>
          <td><strong>Manufacturer</strong></td>
          <td><span>{{ device.manufacturer }}</span></td>
        </tr>
        <tr>
          <td><strong>Country of Origin</strong></td>
          <td><span>{{ device.origin }}</span></td>
        </tr>
        <tr>
          <td><strong>Frequency Range</strong></td>
          <td><span>{{ device.frequency_range }}</span></td>
        </tr>
        <tr>
          <td><strong>Power Output</strong></td>
          <td><span>{{ device.power_output }}</span></td>
        </tr>
        <tr>
          <td><strong>Voltage</strong></td>
          <td><span>{{ device.voltage }}</span></td>
        </tr>
        <tr>
          <td><strong>Certification Standard</strong></td>
          <td><span>{{ device.certification_standard }}</span></td>
        </tr>
      </table>
    </div>
  </div>

  <div class="pagebreak"></div>

  <!-- Page 2 -->
  <div class="frame">
    <div class="content">
      <div class="title-org" style="margin-top:8mm;">Compliance Detail:</div>
      <div class="row" style="text-align:center; margin-bottom: 12mm;">
        This certificate confirms that the product identified above has been tested and found to comply with the requirements of the relevant regulations and standards.<br>The product is approved for sale and use in the Republic of Kiribati.
      </div>

      <div class="row" style="font-weight:700; padding-left: 15mm;">Conditions of Approval:</div>
      <div class="row" style="padding-left: 20mm;">
        <ol style="margin:0; padding-left: 6mm;">
          <li>The certificate holder must ensure continuous compliance with the relevant standards and regulations.</li>
          <li>The product must bear the appropriate type approval mark as specified by the Communications Commission of Kiribati.</li>
          <li>Any modifications to the product must be notified to the issuing authority for further evaluation and approval.</li>
          <li>The certificate holder must maintain records of all products manufactured or imported under this certificate and provide them upon request.</li>
        </ol>
      </div>

      <div class="row" style="margin:10mm auto 0; text-align:center; width: 80%;">
        <strong>THIS CERTIFICATE</strong> shall be valid for all batches of a given type of product specified above, and remains in force as long as the product complies with Rule 2 or cancelled in pursuant to Rule 21 of the Type Approval Rules.
      </div>

      <div class="sign">
        {% if assets.sign_image %}
          <img src="{{ assets.sign_image }}" alt="Sign"/>
        {% endif %}
      </div>
    </div>
  </div>
</body>
</html>
