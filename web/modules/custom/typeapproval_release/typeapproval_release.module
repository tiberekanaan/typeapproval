<?php

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Url;
use Drupal\webform\WebformSubmissionInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\profile\Entity\ProfileInterface;
use Drupal\webform\Entity\WebformOptions;
use Drupal\user\UserInterface;
use Drupal\user\Entity\Role;

/**
 * Redirect users to the front page after login.
 *
 * This prevents applicants from being sent to the dashboard which may expose
 * admin links. We respect an explicitly provided destination (e.g. when
 * coming from a protected page) but override the automatic dashboard redirect.
 */
function typeapproval_release_user_login(UserInterface $account): void {
  $request = \Drupal::requestStack()->getCurrentRequest();

  // Avoid interfering with password reset flow.
  $route_name = \Drupal::routeMatch()->getRouteName();
  if ($route_name === 'user.reset.login') {
    return;
  }

  $query = $request->query;
  $destination = (string) $query->get('destination', '');

  // Determine the dashboard path generated by the Dashboard module.
  $dashboard_path = '';
  try {
    $dashboard_path = Url::fromRoute('dashboard')->toString();
  }
  catch (\Throwable $e) {
    // Dashboard module or route may not exist; ignore.
  }

  // Front page path.
  $front_path = Url::fromRoute('<front>')->toString();

  // If there's no destination OR it is the dashboard path, force front page.
  if ($destination === '' || ($dashboard_path && $destination === $dashboard_path)) {
    $query->set('destination', $front_path);
  }
}

/**
 * Enforce $0 fee and disable Fee field for repeat submissions.
 */
function typeapproval_release_webform_submission_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  $allow_webforms = [
    'type_approval_application_form_i',
    'type_approval_application_form',
    'type_approval_application_form_l',
  ];
  // Ensure this is our target webform.
  if (!in_array($form['#webform_id'], $allow_webforms, TRUE)) {
    return;
  }
  // Obtain current submission data if available.
  $submission = $form['#webform_submission'] ?? NULL;
  $data = [];
  if ($submission instanceof WebformSubmissionInterface) {
    $data = $submission->getData() ?: [];
  }
  // If this is a repeat/child submission, lock fee to $0.
  if (!empty($data['repeat_parent_sid'])) {
    if (isset($form['elements']['fee']) && is_array($form['elements']['fee'])) {
      $form['elements']['fee']['#disabled'] = TRUE;
      $form['elements']['fee']['#default_value'] = '$0';
      $form['elements']['fee']['#value'] = '$0';
    }
  }

  // Apply prefilling ONLY for new submissions (not edits).
  $is_new_submission = TRUE;
  if ($submission instanceof WebformSubmissionInterface) {
    $is_new_submission = $submission->isNew();
  }
  if (!$is_new_submission) {
    return;
  }

  // Get profile and proceed only if available.
  $account = \Drupal::currentUser();
  /** @var \Drupal\Core\Entity\EntityStorageInterface $profile_storage */
  $profile_storage = \Drupal::entityTypeManager()->getStorage('profile');
  /** @var \Drupal\profile\Entity\ProfileInterface|null $profile */
  $profile = NULL;
  if (method_exists($profile_storage, 'loadByUser')) {
    $profile = $profile_storage->loadByUser($account, 'applicant');
  }
  if (!$profile) {
    return;
  }

  // Helper to safely set default value if element has no value yet.
  $set_default = function (&$element, $key, $value) use ($data) {
    if (!isset($element) || !is_array($element)) {
      return;
    }
    // Do not override existing submission data.
    $has_submission_value = array_key_exists($key, $data) && $data[$key] !== '' && $data[$key] !== NULL;
    if ($has_submission_value) {
      return;
    }
    // Do not override already defined defaults.
    if (!empty($element['#default_value'])) {
      return;
    }
    if ($value !== NULL && $value !== '') {
      $element['#default_value'] = $value;
    }
  };

  // Extract values from profile fields.
  $get_text = function ($field_name) use ($profile) {
    if (!$profile->hasField($field_name)) {
      return NULL;
    }
    $val = $profile->get($field_name)->value ?? NULL;
    if ($val === '' || $val === NULL) {
      return NULL;
    }
    return $val;
  };

  $email = $get_text('field_email_address');
  $full_name = $get_text('field_full_name');
  $organization = $get_text('field_organization');
  $physical_address = $get_text('field_physical_address');
  $phone = $get_text('field_telephone');
  $profile_individual_org = $get_text('field_individual_or_organization');

  // Website (link) needs to read uri.
  $website = NULL;
  if ($profile->hasField('field_website') && !$profile->get('field_website')->isEmpty()) {
    $website_item = $profile->get('field_website')->first();
    if ($website_item) {
      try {
        $url_obj = $website_item->getUrl();
        if ($url_obj) {
          $website = $url_obj->toString();
        }
      }
      catch (\Throwable $e) {
        $uri = $website_item->get('uri')->getString();
        if (!empty($uri)) {
          $website = $uri;
        }
      }
    }
  }

  // Normalize helper for individual or organization strictly based on profile field.
  $normalize_individual_org = function ($value) {
    if (is_string($value)) {
      $v = trim($value);
      if (strcasecmp($v, 'Individual') === 0) {
        return 'Individual';
      }
      if (strcasecmp($v, 'Organization') === 0 || strcasecmp($v, 'Organisation') === 0) {
        return 'Organization';
      }
    }
    // No fallback: depend only on field_individual_or_organization.
    return NULL;
  };

  // Determine initial applicant type selections based first on profile fields.
  $individual_or_org = $normalize_individual_org($profile_individual_org);

  // Prefill the initial review selectors if present.
  if (isset($form['elements']['applicant_type_selection']['flexbox_11'])) {
    $ats =& $form['elements']['applicant_type_selection']['flexbox_11'];
    if (isset($ats['individual_or_organization'])) {
      $set_default($ats['individual_or_organization'], 'individual_or_organization', $individual_or_org);
    }
  }

  // Only proceed with Applicant Information if the section exists.
  if (!isset($form['elements']['applicant_information']) || !is_array($form['elements']['applicant_information'])) {
    return;
  }

  // Map and set defaults on form elements based on the rules provided.
  $ai =& $form['elements']['applicant_information'];
  $set_default($ai['flexbox']['mobile'], 'mobile', $phone);

  // Always prefill email and addresses for all cases.
  $set_default($ai['physical_address'], 'physical_address', $physical_address);
  if ($ai['#webform'] == 'type_approval_application_form_i') {
    if (isset($ai['flexbox'])) {
      $set_default($ai['flexbox']['organization'], 'organization', $organization);
      $set_default($ai['flexbox']['website'], 'website', $website);
    }
    if (isset($ai['flexbox_10'])) {
      $set_default($ai['flexbox_10']['email_address'], 'email_address', $email);
      $set_default($ai['flexbox_10']['full_name'], 'full_name', $full_name);
    }
  }
  if ($ai['#webform'] == 'type_approval_application_form_l') {
    if (isset($ai['flexbox'])) {
      $set_default($ai['flexbox']['email_address'], 'email_address', $email);
      $set_default($ai['flexbox']['full_name'], 'full_name', $full_name);
    }
    if (isset($ai['flexbox_10'])) {
      $set_default($ai['flexbox_10']['organization'], 'organization', $organization);
      $set_default($ai['flexbox_10']['website'], 'website', $website);
    }
  }
}

/**
 * Alter Applicant Profile form: change country to select with Webform options.
 */
function typeapproval_release_form_profile_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  // Get the profile entity from the form state.
  $form_object = $form_state->getFormObject();
  if (!$form_object || !method_exists($form_object, 'getEntity')) {
    return;
  }
  $entity = $form_object->getEntity();
  if (!$entity instanceof ProfileInterface) {
    return;
  }
  // Only target the Applicant bundle.
  if ($entity->bundle() !== 'applicant') {
    return;
  }
  // Ensure the field exists on the form.
  if (!isset($form['field_country']['widget'][0]['value']) || !is_array($form['field_country']['widget'][0]['value'])) {
    return;
  }
  // Load Webform options: country_names. Fallback to country_manager if needed.
  $options = [];
  if ($webform_options = WebformOptions::load('country_names')) {
    $options = $webform_options->getOptions() ?: [];
  }
  if (empty($options)) {
    // Fallback: build options as Country name => Country name.
    /** @var \Drupal\Core\Locale\CountryManagerInterface $country_manager */
    $country_manager = \Drupal::service('country_manager');
    $countries = $country_manager->getList();
    $options = array_combine($countries, $countries);
  }
  // Update the widget element to be a select list with the loaded options.
  $element =& $form['field_country']['widget'][0]['value'];
  $element['#type'] = 'select';
  $element['#options'] = $options;
  // Allow an empty selection if the field is not required.
  $required = !empty($element['#required']);
  if (!$required) {
    $element['#empty_option'] = t('- Select -');
    $element['#empty_value'] = '';
  }
}

/**
 * Ensure fee is always $0 for repeat submissions at save time.
 */
function typeapproval_release_webform_submission_presave(WebformSubmissionInterface $webform_submission) {
  $allow_webforms = [
    'type_approval_application_form_i',
    'type_approval_application_form',
    'type_approval_application_form_l',
  ];
  $webform = $webform_submission->getWebform();
  if (!$webform || !in_array($webform->id(), $allow_webforms, TRUE)) {
    return;
  }
  $data = $webform_submission->getData() ?: [];
  if (!empty($data['repeat_parent_sid'])) {
    $data['fee'] = '$0';
    $webform_submission->setData($data);
  }
}

/**
 * Implements hook_theme().
 */
function typeapproval_release_theme($existing, $type, $theme, $path) {
  return [
    'typeapproval_release_pdf' => [
      'variables' => [
        'webform_submission' => NULL,
        'applicant' => [],
        'devices' => [],
        'device' => [],
        'status' => '',
        'generated_on' => '',
        'assets' => [],
        'custom' => '',
      ],
      'template' => 'typeapproval-release-pdf',
    ],
    'typeapproval_release_international_pdf' => [
      'variables' => [
        'webform_submission' => NULL,
        'applicant' => [],
        'devices' => [],
        'device' => [],
        'status' => '',
        'generated_on' => '',
        'assets' => [],
        'custom' => '',
      ],
      'template' => 'typeapproval-release-international-pdf',
    ],
  ];
}

/**
 * Implements hook_webform_submission_view_alter().
 */
function typeapproval_release_webform_submission_view_alter(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display) {
  $allow_webforms = [
    'type_approval_application_form_i',
    'type_approval_application_form',
    'type_approval_application_form_l',
  ];
  // Only add button for the target webform.
  if (method_exists($entity, 'getWebform')) {
    $webform = $entity->getWebform();
    if (!$webform || !in_array($webform->id(), $allow_webforms, TRUE)) {
      return;
    }
  }
  else {
    return;
  }

  if (!$entity->access('view')) {
    return;
  }

  $url = Url::fromRoute('typeapproval_release.generate_pdf', [
    'webform_submission' => $entity->id(),
  ]);

  $link = [
    '#type' => 'link',
    '#title' => t('Generate Release PDF'),
    '#url' => $url,
    '#attributes' => [
      'class' => ['button', 'button--primary'],
    ],
  ];

  // Add the PDF generate button.
  if (isset($build['actions']) && is_array($build['actions'])) {
    $build['actions']['typeapproval_release_pdf'] = $link;
  }
  else {
    $build['typeapproval_release_pdf'] = $link;
  }

  // Add "Request new release" button for the owner when status is Granted.
  $data = $entity->getData();
  $status = (string) ($data['status'] ?? '');
  $is_approved = (strcasecmp($status, 'Approved') === 0);
  $is_granted = (strcasecmp($status, 'Granted') === 0);
  $is_owner = ((int) $entity->getOwnerId() === (int) \Drupal::currentUser()->id());
  if (($is_granted || $is_approved) && $is_owner) {
    $req_url = Url::fromRoute('typeapproval_release.request_new_release', [
      'webform_submission' => $entity->id(),
    ]);
    $req_link = [
      '#type' => 'link',
      '#title' => t('Request new release'),
      '#url' => $req_url,
      '#attributes' => [
        'class' => ['button'],
      ],
    ];
    if (isset($build['actions']) && is_array($build['actions'])) {
      $build['actions']['typeapproval_request_new_release'] = $req_link;
    }
    else {
      $build['typeapproval_request_new_release'] = $req_link;
    }
  }
}

/**
 * Implements hook_entity_update().
 *
 * When the application manager changes the status from Need Review to Approved,
 * generate the release PDF and email it to the application manager.
 */
function typeapproval_release_entity_update(\Drupal\Core\Entity\EntityInterface $entity) {
  if (!$entity instanceof WebformSubmissionInterface) {
    return;
  }

  // Only target the expected webform.
  $webform = $entity->getWebform();
  if (!$webform || ($webform->id() !== 'type_approval_application_form_l' && $webform->id() !== 'type_approval_application_form_i')) {
    return;
  }

  // Get old and new status values.
  $new_data = $entity->getData();
  $new_status = $new_data['status'] ?? '';
  $old_status = '';
  if (isset($entity->original) && $entity->original instanceof WebformSubmissionInterface) {
    $old_data = $entity->original->getData();
    $old_status = $old_data['status'] ?? '';
  }

  // Proceed only if transitioning from Approved -> Granted.
  if (!(strcasecmp($old_status, 'Approved') === 0 && strcasecmp($new_status, 'Granted') === 0)) {
    return;
  }

  // Prevent duplicate sending using a state flag per submission id.
  $sid = $entity->id();
  $state = \Drupal::state();
  $flag_key = 'typeapproval_release.pdf_sent.' . $sid;
  if ($state->get($flag_key)) {
    return;
  }

  $company_address = $new_data['company_address'] ?? [];
  $physical_address = '';
  if ($new_data['physical_address']) {
    $physical_address = $new_data['physical_address'];
  }
  elseif ($company_address) {
    $physical_address = formatAddress($company_address['address'], $company_address['address_2'], $company_address['city'], $company_address['state_province'], $company_address['country']);
  }

  // Build the same render array used by the controller and generate the PDF.
  $applicant = [
    'full_name' => $new_data['full_name'] ?? '',
    'organization' => $new_data['organization'] ?? '',
    'email_address' => $new_data['email_address'] ?? '',
    'mobile' => $new_data['mobile'] ?? '',
    'physical_address' => $physical_address,
  ];
  $devices = [];
  foreach ($new_data['equipments'] as $equipment) {
    $devices[] = [
      'type_of_device' => $equipment['type_of_device'] ?? '',
      'manufacturer' => $equipment['manufacturer'] ?? '',
      'model' => $equipment['model'] ?? '',
      'quantity_of_device' => $equipment['quantity_of_device'] ?? '',
    ];
  }
  // Use first equipment as main device for certificate-style template.
  $first = $new_data['equipments'][0] ?? [];
  $device = [
    'product_name' => $first['product_name'] ?? ($first['model'] ?? ''),
    'model' => $first['model'] ?? '',
    'brand' => $first['brand'] ?? '',
    'category' => $first['category'] ?? ($first['type_of_device'] ?? ''),
    'manufacturer' => $first['manufacturer'] ?? '',
    'origin' => $first['country_of_origin'] ?? ($first['origin'] ?? ''),
    'frequency_range' => $first['frequency_range'] ?? '',
    'power_output' => $first['power_output'] ?? '',
    'voltage' => $first['voltage'] ?? '',
    'certification_standard' => $first['certification_standard'] ?? '',
  ];

  // Resolve module path for assets.
  $module_path = \Drupal::service('extension.list.module')->getPath('typeapproval_release');
  $logo_path = DRUPAL_ROOT . DIRECTORY_SEPARATOR . $module_path . DIRECTORY_SEPARATOR . 'source' . DIRECTORY_SEPARATOR . 'logo.jpg';
  $sign_path = DRUPAL_ROOT . DIRECTORY_SEPARATOR . $module_path . DIRECTORY_SEPARATOR . 'source' . DIRECTORY_SEPARATOR . 'sign.jpg';

  $assets = [
    'logo_image' => _typeapproval_release_to_data_uri($logo_path, 'image/jpeg'),
    'sign_image' => _typeapproval_release_to_data_uri($sign_path, 'image/jpeg'),
  ];

  $custom_entry_point = $new_data['equipments'][0]['custom_entry_point'];
  switch ($custom_entry_point) {
    case 'Customs Betio':
      $custom = 'betio';
      break;
    case 'Customs Bonriki':
      $custom = 'bonriki';
      break;
    case 'DHL Tobaraoi':
      $custom = 'tobaraoi';
      break;
    case 'Postal Office Bairiki':
      $custom = 'bairiki';
      break;
    default:
      $custom = $custom_entry_point;
  }

  // Choose correct template depending on webform (International uses a distinct layout).
  $webform_id = $webform->id();
  $theme_id = ($webform_id === 'type_approval_application_form_i')
    ? 'typeapproval_release_international_pdf'
    : 'typeapproval_release_pdf';
  $orientation = ($webform_id === 'type_approval_application_form_i') ? 'landscape' : 'portrait';

  $build = [
    '#theme' => $theme_id,
    '#webform_submission' => $entity,
    '#applicant' => $applicant,
    '#devices' => $devices,
    '#device' => $device,
    '#generated_on' => \Drupal::service('date.formatter')->format(\Drupal::time()->getRequestTime(), 'custom', 'Y-m-d H:i'),
    '#assets' => $assets,
    '#cache' => ['max-age' => 0],
    '#custom' => $custom,
  ];

  $renderer = \Drupal::service('renderer');
  $html = $renderer->renderPlain($build);

  // Generate PDF using Dompdf.
  $options = new \Dompdf\Options();
  $options->set('isRemoteEnabled', true);
  $options->set('defaultPaperSize', 'a4');
  $dompdf = new \Dompdf\Dompdf($options);
  $dompdf->loadHtml($html);
  $dompdf->setPaper('A4', $orientation);
  $dompdf->render();
  $pdf_data = $dompdf->output();
  $filename = 'Release Form - ' . $new_data['full_name'] . '.pdf';

  // Determine recipients separately for applicant and managers.
  $applicant_email = trim($new_data['email_address'] ?? '');
  $email_validator = \Drupal::service('email.validator');
  $to_applicant = ($applicant_email && $email_validator->isValid($applicant_email)) ? $applicant_email : '';

  $manager_recipients = [];
  $current_user = \Drupal::currentUser();
  if ($current_user->isAuthenticated()) {
    $account = \Drupal\user\Entity\User::load($current_user->id());
    if ($account && in_array('application_manager', $account->getRoles())) {
      $mail = $account->getEmail();
      if (!empty($mail)) {
        $manager_recipients[] = $mail;
      }
    }
  }
  if (empty($manager_recipients)) {
    $user_storage = \Drupal::entityTypeManager()->getStorage('user');
    $uids = $user_storage->getQuery()
      ->condition('status', 1)
      ->condition('roles', 'application_manager')
      ->accessCheck(FALSE)
      ->execute();
    if (!empty($uids)) {
      $users = $user_storage->loadMultiple($uids);
      foreach ($users as $user) {
        $mail = $user->getEmail();
        if (!empty($mail)) {
          $manager_recipients[] = $mail;
        }
      }
    }
  }

  if (empty($to_applicant) && empty($manager_recipients)) {
    \Drupal::logger('typeapproval_release')->warning('No recipients (applicant or managers) found to email release PDF for submission @sid.', ['@sid' => $sid]);
    return;
  }

  $mailManager = \Drupal::service('plugin.manager.mail');
  $langcode = \Drupal::languageManager()->getDefaultLanguage()->getId();

  // Save the PDF to a file first, then read its content for attachment.
  $file_system = \Drupal::service('file_system');
  $temp_uri = 'public://' . $filename;
  $saved_uri = $file_system->saveData($pdf_data, $temp_uri, \Drupal\Core\File\FileExists::Replace);
  if (!$saved_uri) {
    \Drupal::logger('typeapproval_release')->error('Failed to save PDF for submission @sid.', ['@sid' => $sid]);
    return;
  }
  $attachment_content = @file_get_contents($saved_uri);
  if ($attachment_content === FALSE) {
    \Drupal::logger('typeapproval_release')->error('Failed to read PDF for submission @sid.', ['@sid' => $sid]);
    try { $file_system->delete($saved_uri); } catch (\Exception $e) {}
    return;
  }

  // Build absolute URL to the webform submission for inclusion in the email body.
  $submission_url = $entity->toUrl('canonical', ['absolute' => TRUE])->toString();

  // Parameters shared for both emails.
  $base_attachment = [
    [
      'filecontent' => $attachment_content,
      'filename' => $filename,
      'filemime' => 'application/pdf',
      'filepath' => $saved_uri,
    ],
  ];

  $result_any = FALSE;

  // Send to applicant with applicant-focused template.
  if (!empty($to_applicant)) {
    $params_applicant = [
      'subject' => t('Your Type Approval release form for submission @sid', ['@sid' => $sid]),
      'body' => t('Dear applicant,<br/><br/>Your payment has been confirmed and your Type Approval release form is attached for submission @sid.<br/>You can view your submission here: <a href=":url">Submission @sid</a>.<br/><br/>Regards,<br/>CCK', [
        '@sid' => $sid,
        ':url' => $submission_url,
      ]),
      'attachments' => $base_attachment,
    ];
    $result = $mailManager->mail('typeapproval_release', 'release_pdf_applicant', $to_applicant, $langcode, $params_applicant, NULL, TRUE);
    $result_any = $result_any || (!empty($result) && !empty($result['result']));
  }

  // Send to managers with manager-focused template.
  if (!empty($manager_recipients)) {
    $params_manager = [
      'subject' => t('Release form sent to applicant for submission @sid', ['@sid' => $sid]),
      'body' => t('The release form PDF was generated after status changed to Granted and has been sent to the applicant.<br/>Submission link: <a href=":url">Submission @sid</a>.', [
        '@sid' => $sid,
        ':url' => $submission_url,
      ]),
      'attachments' => $base_attachment,
    ];
    foreach (array_unique($manager_recipients) as $to) {
      $result = $mailManager->mail('typeapproval_release', 'release_pdf_manager', $to, $langcode, $params_manager, NULL, TRUE);
      $result_any = $result_any || (!empty($result) && !empty($result['result']));
    }
  }

  if ($result_any) {
    $state->set($flag_key, TRUE);
    \Drupal::logger('typeapproval_release')->notice('Release PDF emailed for submission @sid (applicant and/or managers).', ['@sid' => $sid]);
  }
  else {
    \Drupal::logger('typeapproval_release')->error('Failed to send Release PDF email for submission @sid.', ['@sid' => $sid]);
  }
}

function formatAddress($address, $address2, $city, $stateProvince, $country) {
  $parts = [];

  if (!empty($address)) {
    $parts[] = $address;
  }

  if (!empty($address2)) {
    $parts[] = $address2;
  }

  if (!empty($city)) {
    $parts[] = $city;
  }

  if (!empty($stateProvince)) {
    $parts[] = $stateProvince;
  }

  if (!empty($country)) {
    $parts[] = $country;
  }

  return implode(', ', $parts);
}


/**
 * Helper: Convert a local file to a data URI for embedding in HTML.
 */
function _typeapproval_release_to_data_uri(string $path, string $mime): string {
  if (!is_readable($path)) {
    return '';
  }
  $data = file_get_contents($path);
  if ($data === FALSE) {
    return '';
  }
  return 'data:' . $mime . ';base64,' . base64_encode($data);
}


/**
 * Implements hook_mail().
 */
function typeapproval_release_mail($key, &$message, $params) {
  switch ($key) {
    case 'release_pdf_applicant':
      $subject = !empty($params['subject']) ? $params['subject'] : t('Your Type Approval Release Form');
      $body = !empty($params['body']) ? $params['body'] : t('Dear applicant, please find the attached release form PDF.');
      $message['subject'] = $subject;
      $message['headers']['Content-Type'] = 'text/html; charset=UTF-8';
      $message['headers']['MIME-Version'] = '1.0';
      $message['body'] = [is_array($body) ? implode("\n", $body) : (string) $body];
      break;

    case 'release_pdf_manager':
      $subject = !empty($params['subject']) ? $params['subject'] : t('Release Form Sent to Applicant');
      $body = !empty($params['body']) ? $params['body'] : t('The release form has been generated and sent to the applicant.');
      $message['subject'] = $subject;
      $message['headers']['Content-Type'] = 'text/html; charset=UTF-8';
      $message['headers']['MIME-Version'] = '1.0';
      $message['body'] = [is_array($body) ? implode("\n", $body) : (string) $body];
      break;
  }
}

/**
 * Implements hook_user_presave().
 *
 * Assign the "applicant" role to all newly registered users by default.
 */
function typeapproval_release_user_presave(UserInterface $account) {
  // Only act on brand new users.
  if (!$account->isNew()) {
    return;
  }
  // Do nothing if the role is already present.
  if ($account->hasRole('applicant')) {
    return;
  }
  // Ensure the role exists before assigning.
  $role = Role::load('applicant');
  if (!$role) {
    \Drupal::logger('typeapproval_release')->warning('Cannot auto-assign role: "applicant" role does not exist.');
    return;
  }
  // Assign the role; no explicit save needed in presave hook.
  $account->addRole('applicant');
}


/**
 * Implements hook_preprocess_html().
 *
 * Attach custom CSS for Simplelogin login/register pages to adjust logo layout.
 */
function typeapproval_release_preprocess_html(array &$variables) {
  // If Simplelogin module marked this page, attach our overrides.
  if (!empty($variables['attributes']['class']) && in_array('simplelogin', $variables['attributes']['class'])) {
    $variables['#attached']['library'][] = 'typeapproval_release/simplelogin_overrides';
    return;
  }
  // Also attach on core auth routes as a fallback.
  $route_name = \Drupal::routeMatch()->getRouteName();
  $login_routes = [
    'user.login',
    'user.register',
    'user.pass',
  ];
  if (in_array($route_name, $login_routes, TRUE)) {
    $variables['#attached']['library'][] = 'typeapproval_release/simplelogin_overrides';
  }
}
